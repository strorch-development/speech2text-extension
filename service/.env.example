# Optional image tag if you prefer `docker compose pull` over local builds.
TAG=latest

# Backend port exposed by the container on the host machine.
APP_PORT=8090

# Whisper model: tiny | base | small | small.en | medium | large | large-v3
WHISPER_MODEL=small.en

# Device: cpu (default, no GPU required) or cuda (requires compatible runtime)
WHISPER_DEVICE=cpu

# CTranslate2 compute type. "int8" is a good default for CPU.
WHISPER_COMPUTE_TYPE=int8

# Optional API key to protect the /v1/transcribe endpoint.
SPEECH2TEXT_SERVER_API_KEY=
